# Leave SHOPIFY_STORE_DOMAIN unset to explore the preview catalog and sample journal.
# Set these server-side values in .env.local and in your hosting provider before building.
SHOPIFY_STORE_DOMAIN=
# Public Storefront API token from the Headless channel; never use an Admin API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Create a Shopify blog with this handle, or change it to your existing blog's handle.
SHOPIFY_BLOG_HANDLE=journal
# Your final public HTTPS website URL, for canonical metadata and sitemap entries.
SITE_URL=
