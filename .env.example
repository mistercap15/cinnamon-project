# Leave SHOPIFY_STORE_DOMAIN unset to explore the preview catalog and sample journal.
# Set these server-side values in .env.local and in your hosting provider before building.
SHOPIFY_STORE_DOMAIN=
# Public Storefront API token from the Headless channel; never use an Admin API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Create a Shopify blog with this handle, or change it to your existing blog's handle.
SHOPIFY_BLOG_HANDLE=journal
# Your final public HTTPS website URL, for canonical metadata and sitemap entries.
SITE_URL=

# Optional Medusa mode. npm run demo sets these automatically for the local showcase.
# COMMERCE_PROVIDER=medusa
# MEDUSA_BACKEND_URL=http://127.0.0.1:9000
# MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
# MEDUSA_REGION_ID=reg_your_region
# ACCOUNT_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# DEMO_MODE=true
# SITE_URL=http://localhost:3014

# For manually hosted Medusa, match backend AFTERCARE_API_SECRET. npm run demo supplies this.
# AFTERCARE_API_SECRET=replace-with-the-same-backend-secret
