DATABASE_URL=postgres://username:password@localhost:5432/ceylon
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
COOKIE_SECRET=replace-with-another-unique-random-secret
STORE_CORS=http://localhost:3014
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3014,http://localhost:9000
BACKEND_URL=http://localhost:9000
FRONTEND_URL=http://localhost:3014
# Local-only demonstration inbox. Never enable this for a public deployment.
DEMO_MODE=false
# Required for transactional emails outside the local demonstration.
SMTP_URL=
MAIL_FROM=

# Shared server-to-server secret; use the same value in Next.js. Never expose it publicly.
AFTERCARE_API_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
# Optional change-of-mind policy. Does not limit product-issue requests.
RETURN_WINDOW_DAYS=14
